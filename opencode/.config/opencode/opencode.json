{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "github-copilot": {
      "options": {
        "baseURL": "https://api.business.githubcopilot.com"
      }
    },
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:9090/v1"
      },
      "models": {
        "qwen3.6-27b:thinking": {},
        "qwen3.6-27b:thinking-coding": {},
        "qwen3.6-27b:instruct": {},
        "qwen3.6-27b:instruct-reasoning": {},
        "qwen3.6-35b-a3b:thinking": {},
        "qwen3.6-35b-a3b:thinking-coding": {},
        "qwen3.6-35b-a3b:instruct": {},
        "qwen3.6-35b-a3b:instruct-reasoning": {}
      }
    }
  },
  "mcp": {
    "websearch-fallback": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "-y", "tavily-mcp@latest"],
      "environment": {
        "TAVILY_API_KEY": "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"
      }
    },
    "context": {
      "command": ["context", "serve"],
      "enabled": true,
      "type": "local"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--executable-path",
        "/usr/sbin/brave"
      ],
      "enabled": true
    },
    "tauri": {
      "type": "local",
      "command": ["npx", "-y", "@hypothesi/tauri-mcp-server@latest"],
      "enabled": true
    }
  },
  "plugin": ["oh-my-openagent@latest"]
}
